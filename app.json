{
  "expo": {
    "name": "SPOT",
    "slug": "spot-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "spot",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D0F",
    "primaryColor": "#C8FF3D",
    "splash": {
      "backgroundColor": "#0B0D0F",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ihor.spot",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "com.ihor.spot",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D0F"
      }
    }
  }
}