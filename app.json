{
  "expo": {
    "name": "SPOT",
    "slug": "spot-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "spot",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D0F",
    "primaryColor": "#C8FF3D",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0D0F"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vanzalabs.spot",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.vanzalabs.spot",
      "versionCode": 1,
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0D0F"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "396d894f-4173-4935-9545-a61c55acf590"
      }
    },
    "owner": "boklans"
  }
}
