{
  "expo": {
    "name": "SPOT",
    "slug": "spot-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "spot",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ihor.spot"
    },
    "android": {
      "package": "com.ihor.spot"
    }
  }
}