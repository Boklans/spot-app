{
  "expo": {
    "name": "SPOT",
    "slug": "spot-app",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "spot",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0D0F",
    "primaryColor": "#C8FF3D",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0D0F"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0D0F",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#0B0D0F"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C8FF3D"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SPOT to access your photo library to set a custom profile or exercise photo. / Дозвольте SPOT доступ до галереї для встановлення фото профілю або власної вправи.",
          "cameraPermission": "Allow SPOT to access your camera to take a custom profile or exercise photo. / Дозвольте SPOT доступ до камери, щоб зробити фото профілю або власної вправи."
        }
      ],
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vanzalabs.spot",
      "buildNumber": "6",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow SPOT to access your photo library to set a custom profile or exercise photo. / Дозвольте SPOT доступ до галереї для встановлення фото профілю або власної вправи.",
        "NSCameraUsageDescription": "Allow SPOT to access your camera to take a custom profile or exercise photo. / Дозвольте SPOT доступ до камери, щоб зробити фото профілю або власної вправи."
      }
    },
    "android": {
      "package": "com.vanzalabs.spot",
      "versionCode": 6,
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0D0F"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "396d894f-4173-4935-9545-a61c55acf590"
      }
    },
    "owner": "boklans"
  }
}
